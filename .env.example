# Minimum local configuration
# Heroku supplies DATABASE_URL automatically after Postgres is provisioned.
DATABASE_URL=postgresql://user:password@localhost:5432/orderdesk_shipping

# Leave these blank and `npm run heroku:configure -- --app YOUR_APP_NAME`
# generates secure values, saves them only in .env, and uploads them to Heroku.
INBOUND_API_KEY=
ADMIN_API_KEY=

# Add the Order Desk stores this deployment accepts.
STORE_21633=replace-me
STORE_40348=replace-me

# Optional local and advanced overrides. Heroku detects these defaults itself.
PORT=4000
NODE_ENV=development
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
REQUIRE_INBOUND_AUTH=false
REQUEST_BODY_LIMIT=5mb
ORDERDESK_REQUEST_TIMEOUT_MS=30000
ORDERDESK_BATCH_SIZE=100
RATE_LIMIT_LOG=warn
RATE_LIMIT_WARN_TOKENS=5
WORKER_POLL_INTERVAL_MS=1000
WORKER_CLAIM_SIZE=100
WORKER_CONCURRENCY=10
WORKER_LEASE_SECONDS=300
WORKER_MAX_ATTEMPTS=8
